
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Train Stage 1",
            "type": "shell",
            "command": "/opt/conda/bin/python",
            "args": [
                "${workspaceFolder}/train.py",
                "--config",
                "${workspaceFolder}/configs/stage1.yaml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
